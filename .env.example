# =============================================================================
# Digital Asset Library — environment variables
#
# Copy this file to .env.local and fill in the real values (.env.local is
# git-ignored). Mirror the SAME values in the Vercel dashboard:
#   Vercel → Project (digital-library) → Settings → Environment Variables
#   (add to Production + Preview + Development).
#
# Supabase project ref: cmluzusujsbxscljszbn
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# Supabase renamed its keys: the legacy anon / service_role JWTs are now
# "publishable" (sb_publishable_…) and "secret" (sb_secret_…). The app accepts
# either spelling — see lib/env.ts — so use whichever your dashboard shows.

# Public. Safe in the browser; every request is subject to Row-Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://cmluzusujsbxscljszbn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. BYPASSES Row-Level Security. Never expose it to the client,
# never import it into a client component, never commit the real value.
# Used by lib/supabase/server.ts (createAdminClient) and the CLI scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Database connection (required by the CLI scripts only) ------------------
# Used by `npm run db:push` and `npm run db:seed`. Take it from
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Use the SESSION pooler on port 5432: transaction mode (6543) cannot run the
# DDL in the migrations, and the direct host db.<ref>.supabase.co is IPv6-only
# and will not resolve on most networks.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Site URL (recommended in production) ------------------------------------
# Absolute origin used for canonical links, OpenGraph, sitemap.xml and the
# links in confirmation emails. Set this once a custom domain is attached;
# without it the app falls back to the Vercel deployment URL, then localhost.
# Setting it also switches robots.txt from "disallow all" to indexable.
# NEXT_PUBLIC_SITE_URL=https://library.urbanjunglegoddess.com

# --- OAuth sign-in (optional) -------------------------------------------------
# Comma-separated provider ids to show on the sign-in page. Each must ALSO be
# enabled with a client id/secret in Supabase → Authentication → Providers,
# otherwise the button leads nowhere. Leave unset for email + magic link only.
# Supported: github, google, gitlab, bitbucket, azure, apple, discord, figma,
#            notion, slack_oidc
# NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=github,google

# --- Web search proxy (optional) ----------------------------------------------
# Powers /api/websearch. Without a key the endpoint still answers, returning
# scoped search links for MDN, the WAI-ARIA APG, Stack Overflow and GitHub.
# WEBSEARCH_PROVIDER=brave
# WEBSEARCH_API_KEY=your-provider-key
