# =============================================================================
# Digital Asset Library — environment variables
#
# Copy this file to .env.local and fill in the real values (.env.local is
# git-ignored). Mirror the SAME values in the Vercel dashboard:
#   Vercel → Project (digital-library) → Settings → Environment Variables
#   (add to Production + Preview + Development).
#
# Supabase project ref: cmluzusujsbxscljszbn
# =============================================================================

# Public — safe to expose to the browser. Used by both the server SSR client
# and the browser client. Subject to Row-Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://cmluzusujsbxscljszbn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — the service-role key BYPASSES Row-Level Security. Never expose
# it to the client, never import it into a client component, never commit the
# real value. Used only by lib/supabase/server.ts (createAdminClient).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
